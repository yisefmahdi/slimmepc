APP_NAME="SlimmePC"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nl_NL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# The project is built for MySQL (database name: slimmepc_2026).
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=slimmepc_2026
DB_USERNAME=root
DB_PASSWORD=

# Alternative: quick local dev without MySQL (create the file first):
# touch database/database.sqlite   (Windows: New-Item database\database.sqlite)
# DB_CONNECTION=sqlite
# DB_DATABASE="database/database.sqlite"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail
# "log" writes emails to storage/logs/laravel.log — perfect for local dev.
# For real mail, switch to smtp and fill in your provider's details.
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@slimme-pc.nl"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Inbound contact e-mail (IMAP) — used by "php artisan contact:fetch-inbound"
# Customer replies arrive on the "+reply-{id}" alias of the Gmail address
# used for MAIL_FROM_ADDRESS. Requires IMAP enabled in Gmail + an App Password.
# ---------------------------------------------------------------------------
CONTACT_IMAP_HOST=imap.gmail.com
CONTACT_IMAP_PORT=993
CONTACT_IMAP_ENCRYPTION=ssl
CONTACT_IMAP_VALIDATE_CERT=true
CONTACT_IMAP_USERNAME=
CONTACT_IMAP_PASSWORD=
CONTACT_IMAP_MAILBOX=INBOX

# Admin notification e-mail: gets an e-mail with the submitter's details and
# a dashboard link for every new contact submission. Empty = use MAIL_FROM_ADDRESS.
CONTACT_NOTIFY_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

